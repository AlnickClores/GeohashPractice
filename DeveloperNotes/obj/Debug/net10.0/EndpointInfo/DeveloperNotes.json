{
  "openapi": "3.1.1",
  "info": {
    "title": "DeveloperNotes | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7087"
    },
    {
      "url": "http://localhost:5239"
    }
  ],
  "paths": {
    "/redis-test": {
      "get": {
        "tags": [
          "DeveloperNotes"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/geohash/collectors": {
      "post": {
        "tags": [
          "GeoHash"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectorRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectorRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/geohash/targets": {
      "post": {
        "tags": [
          "GeoHash"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTargetRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTargetRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTargetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/geohash/targets/{targetId}/nearby-collectors": {
      "get": {
        "tags": [
          "GeoHash"
        ],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NearbyCollectorsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/NearbyCollectorsRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/NearbyCollectorsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/geohash/targets/{targetId}/assign": {
      "post": {
        "tags": [
          "GeoHash"
        ],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignTargetRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignTargetRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AssignTargetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/geohash/GetGeohash": {
      "get": {
        "tags": [
          "GeoHash"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeohashRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GeohashRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GeohashRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignTargetRequest": {
        "type": "object",
        "properties": {
          "collectorId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Coordinates": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateCollectorRequest": {
        "required": [
          "name",
          "coordinates"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          }
        }
      },
      "CreateTargetRequest": {
        "required": [
          "name",
          "coordinates"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          }
        }
      },
      "GeohashRequest": {
        "required": [
          "keyType",
          "name"
        ],
        "type": "object",
        "properties": {
          "keyType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "NearbyCollectorsRequest": {
        "required": [
          "targetId"
        ],
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string"
          },
          "radiusKm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DeveloperNotes"
    },
    {
      "name": "GeoHash"
    }
  ]
}